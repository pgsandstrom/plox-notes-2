{
  "name": "plox-notes-2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "PGPORT=${PGPORT:-5433} node --watch-path=server --watch-path=types server/index.ts",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d",
    "docker-build": "docker compose build --no-cache",
    "docker-up": "docker compose up -d",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "pnpm run knip:production && pnpm run knip:default",
    "knip:default": "knip --no-progress",
    "knip:production": "knip --production --files --no-progress",
    "lint": "oxlint",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run validate && pnpm run format:check",
    "prepare": "husky",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-textarea-autosize": "8.5.9",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.23.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "husky": "9.1.7",
    "knip": "6.39.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,mts,cts})": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.8.1"
}
