{
  "name": "plox-notes-2",
  "version": "1.0.0",
  "private": false,
  "scripts": {
    "build": "next build && tsc --project tsconfig.server.json",
    "dev": "nodemon",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d",
    "dev-database-build": "docker compose -f docker-compose-dev.yml build",
    "docker-build": "docker compose build --no-cache",
    "docker-up": "docker compose up -d",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run validate && pnpm run format:check",
    "prepare": "husky",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "typecheck": "next typegen && tsc --noEmit",
    "validate": "pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "cross-env": "10.1.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-textarea-autosize": "8.5.9",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "styled-jsx": "5.1.6",
    "uuid": "14.0.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.23.3",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint-plugin-no-only-tests": "3.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nodemon": "3.1.14",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,mts,cts})": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.8.1"
}
