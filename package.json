{
  "name": "plox-notes-2",
  "version": "1.0.0",
  "private": false,
  "scripts": {
    "build": "next build && tsc --project tsconfig.server.json",
    "dev": "nodemon",
    "dev-database": "docker compose -f docker-compose-dev.yml up -d",
    "dev-database-build": "docker compose -f docker-compose-dev.yml build",
    "docker-build": "docker compose build --no-cache",
    "docker-up": "docker compose up -d",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run validate && pnpm run format:check",
    "prepare": "husky",
    "start": "cross-env NODE_ENV=production node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run typecheck && pnpm run lint"
  },
  "dependencies": {
    "@types/lodash": "4.14.199",
    "@types/node": "18.18.4",
    "@types/pg": "8.10.5",
    "@types/react": "18.2.28",
    "@types/react-dom": "18.2.13",
    "@types/uuid": "9.0.5",
    "cross-env": "7.0.3",
    "lodash": "4.17.21",
    "next": "13.5.4",
    "pg": "8.11.3",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-flip-move": "3.0.5",
    "react-textarea-autosize": "8.5.3",
    "socket.io": "4.7.2",
    "socket.io-client": "4.7.2",
    "ts-node": "10.9.1",
    "typescript": "5.2.2",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.23.3",
    "eslint-plugin-no-only-tests": "3.4.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "nodemon": "3.0.1",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "!(*.{js,jsx,ts,tsx,mjs,cjs,mts,cts})": [
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  },
  "packageManager": "pnpm@12.8.1"
}
